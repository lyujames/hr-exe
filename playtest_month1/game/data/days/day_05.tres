desk_texts = [{"id": "t5_1", "at": 570, "text": "老婆：今天接你爸出院，我请了半天假。", "replies": [{"key": "warm", "label": "这阵子辛苦你了。", "marriage": 1}, {"key": "curt", "label": "好。", "marriage": 0}]}, {"id": "t5_2", "at": 800, "text": "老婆：孩子早上出门前还在说编程班的事。", "replies": [{"key": "warm", "label": "周末带他去试听。", "marriage": 1}, {"key": "curt", "label": "先别报，太贵。", "marriage": 0}]}]
sms_flag = "d5_eve"
sms_replies = [{"key": "warm", "label": "编程班周末咱们去看看。", "marriage": 1}, {"key": "curt", "label": "编程班太贵了，再说。", "marriage": 0}, {"key": "silent", "label": "（不回）", "family": -1, "marriage": -1}]
home_scene = [{"text": "到家 18:45。你爸也在，老婆把他接过来住几天。他坐在沙发上，比上次见瘦了一圈。"}, {"text": "你爸：你们公司还招人吗？老单位小刘的儿子，研究生毕业半年了还在家待着。"}, {"ask": "h5_dad", "options": [{"key": "try", "label": "让他投个简历试试。", "then": [{"text": "你爸：我就说嘛，你在里面，好说话。"}, {"text": "你爸：小刘说了，不让你白忙。他们家懂规矩，该表示的会表示。"}, {"text": "你没接话。"}]}, {"key": "hard", "label": "现在不好进，我也说不上话。", "then": [{"text": "你爸：你都管招聘了，还说不上话？"}, {"text": "你爸：人家也不是空着手求人。过年那两条烟，小刘还记着呢。"}, {"text": "老婆：爸，吃菜。"}]}]}, {"text": "孩子：妈妈说周末去看编程班，是真的吗？", "when": "d5_eve:warm"}, {"text": "你：真的。", "when": "d5_eve:warm"}, {"text": "孩子跑去给爷爷看他在平板上拼的小游戏，一只猫追一条鱼。", "when": "d5_eve:warm"}, {"text": "孩子没提编程班。吃完饭，他把平板上那个试听课的广告划掉了。", "when": "d5_eve:curt"}, {"text": "孩子：爸爸，妈妈说帮我给你发短信了，你看到了吗？", "when": "d5_eve:silent"}, {"text": "你：……还没来得及。", "when": "d5_eve:silent"}, {"text": "孩子：哦。", "when": "d5_eve:silent"}, {"text": "夜里，你爸在客厅咳了好几声。老婆起来给他倒了杯水。"}, {"ask": "h5_night", "options": [{"key": "thanks", "label": "等她回来，跟她说：这阵子多亏你了。", "marriage": 1, "then": [{"text": "老婆：你爸也是我爸。睡吧。"}], "say": "她回来躺下，你说：这阵子多亏你了。"}, {"key": "sleep", "label": "装睡。", "then": [{"text": "她躺下的时候，动作很轻。"}], "say": "你闭着眼，没出声。"}]}]
