boss_mail = "各位家人：
实习生要能长期干：每周到岗至少 4 天，能实习至少 6 个月，两条都要够。
两个岗都一样。手册上的规则照旧，一条都不能松。
—— 王总"
coworker_note = "老周的便签：
“可实习”那一行在简历背面，翻过去看。
昨天的规则还在，规则只增不减。"
bills = [{"id": "tutoring", "label": "孩子补习班", "amount": 60}]
headline = "AI 招聘工具宣称“提升效率 300%”"
news_body = "HireBot 母公司完成新一轮融资。CEO：“HR 的未来，是不再需要 HR 的未来。”"
story_echoes = [{"when": "story_steady:hired", "bonus": {"label": "王总特批：方晓", "amount": 100}}, {"when": "!story_perfect:hired", "headline": "“简历近乎完美”的实习生，入职第三天卷走项目备用金", "body": "涉事者顾某，东江大学大四，绩点 3.92。简历上三个项目都写着“负责人”，时间互相重叠；附三封推荐信，措辞一模一样。一家公司录用了他，该公司 HR 说：“哪条都挑不出毛病，我们没理由不要。”"}]
news_by_event = {"embezzle": ["本市一互联网公司实习生卷走活动经费失联", "该实习生简历上三个项目都是“负责人”，时间互相重叠，附三封措辞一模一样的推荐信。公司负责人称：“面试时表现完美。”"]}
family_sms = "老婆：你爸出院了，医生让下个月复查。
老婆：孩子说班上同学都去学编程了，他也想去。"
chief_opener = "今天面的有写东西的，也有做运营的。我不管，进来都归我带。"
chief_question = ExtResource("chief_q")
candidate_ask = ExtResource("chief_a")
desk_texts = [{"id": "t5_1", "at": 570, "text": "老婆：今天接你爸出院，我请了半天假。", "replies": [{"key": "warm", "label": "这阵子辛苦你了。", "marriage": 1}, {"key": "curt", "label": "好。", "marriage": 0}]}, {"id": "t5_2", "at": 800, "text": "老婆：孩子早上出门前还在说编程班的事。", "replies": [{"key": "warm", "label": "周末带他去试听。", "marriage": 1}, {"key": "curt", "label": "先别报，太贵。", "marriage": 0}]}]
sms_flag = "d5_eve"
sms_replies = [{"key": "warm", "label": "编程班周末咱们去看看。", "marriage": 1}, {"key": "curt", "label": "编程班太贵了，再说。", "marriage": 0}, {"key": "silent", "label": "（不回）", "family": -1, "marriage": -1}]
home_scene = [{"text": "到家 18:45。你爸也在，老婆把他接过来住几天。他坐在沙发上，比上次见瘦了一圈。"}, {"text": "你爸：你们公司还招人吗？老单位小刘的儿子，研究生毕业半年了还在家待着。"}, {"ask": "h5_dad", "options": [{"key": "try", "label": "让他投个简历试试。", "then": [{"text": "你爸：我就说嘛，你在里面，好说话。"}, {"text": "你爸：小刘说了，不让你白忙。他们家懂规矩，该表示的会表示。"}, {"text": "你没接话。"}]}, {"key": "hard", "label": "现在不好进，我也说不上话。", "then": [{"text": "你爸：你都管招聘了，还说不上话？"}, {"text": "你爸：人家也不是空着手求人。过年那两条烟，小刘还记着呢。"}, {"text": "老婆：爸，吃菜。"}]}]}, {"text": "孩子：妈妈说周末去看编程班，是真的吗？", "when": "d5_eve:warm"}, {"text": "你：真的。", "when": "d5_eve:warm"}, {"text": "孩子跑去给爷爷看他在平板上拼的小游戏，一只猫追一条鱼。", "when": "d5_eve:warm"}, {"text": "孩子没提编程班。吃完饭，他把平板上那个试听课的广告划掉了。", "when": "d5_eve:curt"}, {"text": "孩子：爸爸，妈妈说帮我给你发短信了，你看到了吗？", "when": "d5_eve:silent"}, {"text": "你：……还没来得及。", "when": "d5_eve:silent"}, {"text": "孩子：哦。", "when": "d5_eve:silent"}, {"text": "睡前，孩子抱着一面小旗从房间跑出来。"}, {"text": "孩子：爸爸！明天升旗我当护旗手！早上八点，在操场。"}, {"ask": "h5_flag", "options": [{"key": "go", "label": "爸爸去看，站第一排。", "marriage": 1, "late": 120, "morning": "八点，国歌响起来。孩子走在旗杆前面，步子迈得特别大，经过第一排的时候往你这边瞟了一眼，又赶紧绷住脸。\n散场他跑过来：“你看见了吗？我一步都没错！”\n你说看见了。九点半，你从校门口挤上地铁。", "then": [{"text": "孩子：真的？你要站第一排！"}, {"text": "他把小旗插在你公文包的侧兜里。"}]}, {"key": "work", "label": "爸爸明天要上班，让妈妈给你拍视频。", "then": [{"text": "孩子：……哦。"}, {"text": "孩子：妈妈拍的都是糊的。"}]}]}, {"text": "夜里，你爸在客厅咳了好几声。老婆起来给他倒了杯水。"}, {"ask": "h5_night", "options": [{"key": "thanks", "label": "等她回来，跟她说：这阵子多亏你了。", "marriage": 1, "then": [{"text": "老婆：你爸也是我爸。睡吧。"}], "say": "她回来躺下，你说：这阵子多亏你了。"}, {"key": "sleep", "label": "装睡。", "then": [{"text": "她躺下的时候，动作很轻。"}], "say": "你闭着眼，没出声。"}]}]
