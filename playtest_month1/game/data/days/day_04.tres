story_slot = 2
candidate_mix = {"fresh": 100}
morning_push = "内容岗实习“卷”出新高度：一个岗位上千份简历"
boss_mail = "各位家人：
新开一个岗：内容运营实习生，JD 我让人放你桌上了，一个岗一页。
写东西的岗，要的专业跟产品运营不一样，别看串了。
昨天那个实习生我看了，还行。今天继续面。
—— 王总"
coworker_note = "老周的便签：
从今天起先看简历上“应聘”哪个岗，再翻到那一页 JD。
学市场营销的投内容运营，不行；学新闻的投产品运营，也不行。
研究生的本科专业写在小字里，那个不算。"
bills = [{"id": "tutoring", "label": "孩子补习班", "amount": 60}, {"id": "hospital", "label": "父亲住院押金", "amount": 150}]
headline = "三十岁的研究生：“实习生”这个身份，我等了很久"
news_body = "教培行业退潮后，不少前从业者回校读研，再以实习生身份重新求职。受访者：“专业是照着能考上的报的，没想过后来会卡在这一栏。”"
story_echoes = [{"when": "story_thirty:reject", "headline": "三十岁的研究生：“实习生”这个身份，我等了很久", "body": "受访者：“本科学的就是中文，写了三年教案。今天收到的回信说：{reason}”"}]
family_sms = "老婆：手续我一个人办完了。押金要交。\n老婆：你忙吧。"
family_sms_by = [{"when": "d4_left:yes", "sms": "老婆：你来了，你爸就踏实了，刚睡着。\n老婆：押金要交。医生说先观察几天。"}]
midday_call = {"at": 720, "text": "老婆：你爸住院了。你能早点回来吗？", "flag": "d4_left"}
chief_opener = "实习生我见多了，干两个月就回去写论文。你把把关。"
chief_need = {"item": "稳定性", "note": "别招干两个月就跑的。"}
chief_question = ExtResource("chief_q")
candidate_ask = ExtResource("chief_a")
desk_texts = [{"id": "t4_1", "at": 520, "text": "老婆：我陪你爸在医院排队，心电图要等。", "replies": [{"key": "warm", "label": "辛苦了，有事马上打给我。", "marriage": 1}, {"key": "curt", "label": "嗯。", "marriage": 0}]}, {"id": "t4_2", "at": 820, "text": "老婆：医生说要住几天。我回家拿点东西，晚上再来。", "replies": [{"key": "warm", "label": "晚上我去医院守着。", "marriage": 1}, {"key": "curt", "label": "好。", "marriage": 0}]}]
sms_flag = "d4_eve"
sms_replies = [{"key": "warm", "label": "今晚我守着，你回去歇歇。", "marriage": 1}, {"key": "curt", "label": "押金我明天交。", "marriage": 0}, {"key": "silent", "label": "（不回）", "family": -1, "marriage": -1}]
home_scene = [{"text": "你在医院走廊的折叠椅上坐了一夜。你爸睡着了，呼吸声很重。", "when": "d4_eve:warm"}, {"text": "十一点，老婆发来一张照片：孩子趴在桌上写作业，旁边是一张画，画的是爷爷和一个很大的太阳。", "when": "d4_eve:warm"}, {"ask": "h4_photo", "options": [{"key": "reply", "label": "回她：画得真好。替我亲他一下。", "marriage": 1, "then": [{"text": "老婆：亲了。他嫌我口水多。"}], "say": "你回她：画得真好。替我亲他一下。"}, {"key": "look", "label": "看了很久，没回。", "then": [{"text": "护士推着车从你面前过去。你把手机屏幕按灭了。"}], "say": "你看了很久，没回。"}], "when": "d4_eve:warm"}, {"text": "你从医院回来，到家八点多。孩子还没睡，在等你。", "when": "!d4_eve:warm&d4_left:yes"}, {"text": "老婆：今天你来了，你爸挺高兴的。嘴上还在说你不该请假。", "when": "!d4_eve:warm&d4_left:yes"}, {"text": "你到家 18:55。老婆刚从医院回来，外套还没脱。", "when": "!d4_eve:warm&d4_left:"}, {"text": "老婆：你爸一下午都在问你来不来。我说你在开会。", "when": "!d4_eve:warm&d4_left:"}, {"text": "老婆：押金我先垫上了。你明天记得把钱转我。", "when": "d4_eve:curt"}, {"text": "孩子：爸爸，爷爷会死吗？", "when": "!d4_eve:warm"}, {"ask": "h4_kid", "options": [{"key": "no", "label": "不会，爷爷就是住几天院。", "then": [{"text": "孩子：那我能去看他吗？"}, {"text": "你：周末去。"}]}, {"key": "honest", "label": "爸爸也不知道。医生在想办法。", "marriage": 1, "then": [{"text": "他想了一会儿，把一张画塞到你手里：“那你明天带给他。”"}, {"text": "画上是爷爷，还有一个很大的太阳。"}, {"text": "老婆站在门口听见了，没说话，过来拍了拍你的背。"}]}], "when": "!d4_eve:warm"}]
