[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_return_offer"
text_key = "实习结束要是没有转正名额，你怎么打算？"
probes = PackedStringArray("loyalty")
honest = "那就把这段写进简历，去下一家。"
honest_low = "那我可能实习到一半，就去找能转正的了。"
standard = "我相信只要做得好，机会自然会来。"
flaw = "没、没有名额吗？……那，那也行。"
audience = "intern"
chief_item = "稳定性"
chief_standard = "对，机会留给有准备的人。"
chief_honest = "实话。可惜。"
chief_flaw = "名额的事我说了不算。"
