[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_weakness"
text_key = "你最大的缺点是什么？"
probes = PackedStringArray("honesty")
honest = "我做事慢，正在改。"
honest_low = "我有时候会回避冲突，这点不太好。"
standard = "我太追求完美了。"
flaw = "缺点？我……太追求完美了吧，应该。"
chief_item = "格局"
chief_standard = "完美主义，我们就缺这个。"
chief_honest = "缺点还是别说这么具体。"
chief_flaw = "嗯，我也完美主义。"
followup_text = "举个例子？最近一次是什么时候？"
honest_followup = "上周交课程报告，别人一天写完，我写了三天，因为把数据又核了一遍。"
honest_low_followup = "上个月小组作业，组员吵起来，我没说话，最后报告是乱的。"
standard_followup = "例子……一时想不起来，反正就是太认真了。"
flaw_followup = "例、例子？……就是，就是太完美了。"
