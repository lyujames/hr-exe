[gd_resource type="Resource" script_class="CandidateAsk" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/CandidateAsk.gd" id="1"]

[resource]
script = ExtResource("1")
question = "实习生能写进项目成员里吗？"
student_question = "我做的东西，项目成员那栏能写我的名字吗？上次在学校就没写。"
lie = "当然，谁做的写谁。"
safe = "按项目的规范来。"
truth = "一般写带你的人。"
