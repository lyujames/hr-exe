[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"chief_sharp_day11"
text_key = "我现在就给你上家领导打电话，他会怎么说你？"
probes = PackedStringArray("honesty")
audience = "regular"
sharp = true
honest = "会说我活干得干净，但不太听话。他让我跳过测试上线，我没跳。"
honest_low = "……他可能不太会说好话。我们最后闹得不太好。"
standard = "他会说我是团队的核心骨干，对我评价很高。"
flaw = "打、打电话？他……他最近换号了。"
followup_text = "号码给我，我现在拨。"
honest_followup = "（TA 直接把手机推过来，通讯录已经翻到那一页。）打吧，他下午一般在。"
honest_low_followup = "（TA 把号码写在纸上，写完又补了一句：“他说什么，您先听我解释。”）"
standard_followup = "……这个，背调的时候 HR 会联系的。现在打不太合适吧。"
flaw_followup = "我、我手机……没电了。"
chief_item = "稳定性"
chief_standard = "骨干，好。"
chief_honest = "不听话的不要。"
chief_flaw = "心虚了吧。"
