[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"chief_day13"
text_key = "你觉得 AI 会替代程序员吗？"
probes = PackedStringArray("ability")
honest = "会替掉一部分活，最先是增删改查。我在往它干不了的地方挪。"
honest_low = "我不知道……我现在写的东西，它好像都会。"
standard = "AI 只是工具，替代不了有经验的工程师。"
flaw = "不、不会吧……应该不会。"
followup_text = "那它干不了的是什么？"
honest_followup = "线上出事的时候知道先救哪个。它不知道哪个客户会打电话骂人。"
honest_low_followup = "……我也说不上来。"
standard_followup = "主要是经验、判断力这些软实力。"
flaw_followup = "干、干不了……很多都干不了。"
chief_item = "格局"
chief_standard = "对，替不了。那玩意我看过，离了人写不了东西。"
chief_honest = "危言耸听。"
chief_flaw = ""
audience = "regular"
