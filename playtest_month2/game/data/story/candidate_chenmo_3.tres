answers = {"q_weakness": "不太会说话。面试一般到这一步就没了。", "q_tech_depth": "精通不敢说。Banyan 的调度器我重写过三遍，第一版有个死锁，两万个项目一起挂。", "q_tech_depth+": "有人在 issue 里贴了线程 dump。我那天在医院陪我妈，用手机看的，凌晨四点修完。", "q_leaving": "没离开。一直在维护，只是没人发工资。", "q_company": "你们核心系统跑的是 Banyan 1.4，有个已知的内存泄漏，我在 1.6 修了。你们没升。", "q_company+": "你们日志里每天凌晨两点会有一串 GC 告警。就是那个。", "q_future": "先有个地方按月发工资。Banyan 我晚上接着写。", "q_oncall": "Banyan 的 issue 是全世界的时区。我没有凌晨三点。", "r_edu": "自考还差两门，数据结构和英语。数据结构我给别人讲过，英语在背。6 月考。", "r_edu+": "考出来之前，你们的规则上我还是高中。我知道。", "r_job:0": "没人发工资的那种维护。Banyan 的 issue 我一个人回，一年两千多条。", "r_job:1": "外包三年，写银行的报表系统。我走的时候它一天跑四万张报表，现在应该还在跑。", "r_self_eval": "上回那份是照教程写的，你们说堆砌。这回我只写我会的。", "r_self_eval+": "13k 是小孟说的上限。我没问过别的组。", "lead_it_legacy": "先不动它。把它每天几点跑、读哪几张表记下来，记一个月。2012 年的代码能跑到今天，说明它比我们以为的懂业务。", "lead_it_legacy+": "Banyan 里也有一段 2019 年的代码我一直没删。删了三次，三次都有人来 issue 里说他们靠它活着。", "lead_it_sharp": "三十七笔，先看是哪一天开始少的。少的那天前后谁改过东西，日志里都有。", "lead_it_users": "能改。按钮放大以后表格会挤，我顺手把那一栏也挪了。王总不会发现，用的人会。"}
epilogue = {"hired": "你录用了他。定薪那天王总说：没学历，按 8k 走。比他自己写的 13k 又少了五千。他说行。", "exception": "你破格放了他，面试后没录用。小孟在走廊里看了你一眼，什么都没说。", "pass": "你放了他。违规单上写着：应拒绝：学历要求。还差两门。", "reject": "你回他：“{reason}”。这是他第三次投蜂巢，这次连价钱也让了。他没有再投。"}
skip_when = "story_chenmo_1:hired|story_chenmo_2:hired"
id = &"story_chenmo_3"
