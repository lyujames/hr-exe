answers = {"q_intern_role": "拉群、写文案、盯数据，再加上您说的杂活。学院公众号我做了两年，杂活我熟。", "q_project": "公众号是我一个人做的：选题、排版、半夜回留言。粉丝从三百涨到四千。", "q_our_app": "用过。搜“奶茶”出来一堆健身课，我截了图，记在本子上。", "q_data_test": "（算得很快，又从头验了一遍。）百分之三十一点二。", "q_chores": "能。我在食堂打过两年工，比这累。", "q_schedule": "下周开学，课表我带来了。周一下午、周四上午有课，其余都能来。", "q_return_offer": "那我回去好好读本科。两年后再投一次，到时候学历就够了。", "q_friday": "先回“在”，再看是什么事。", "q_weakness": "学历。再过一周就不是了。", "chief_intern_job": "打杂、跑腿、加班。我都做好准备了。", "chief_weekend": "可以。周末我本来也在兼职。"}
epilogue = {"hired": "你放了她。开学那天，她在工位上给你看了学生证。", "pass": "你放了她，面试后没录用。她开学了。", "reject": "你回她：“{reason}”。下周一她就是本科生了。"}
