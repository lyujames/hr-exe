[gd_resource type="Resource" script_class="Quirk" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/Quirk.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quirk_ma_ma"
entrance = "（TA 进门，后面跟进来一位阿姨，拎着保温杯。阿姨先坐下了，TA 站着。“妈，那是我的椅子。”）"
answers = {"q_overtime": "（阿姨抢着说：“加班可以，晚饭得回家吃。这孩子胃不好。”）（TA：“……妈。”）", "q_weakness": "（阿姨：“没缺点。就是太老实。”）（TA 张了张嘴，没说出来。）", "q_future": "（阿姨：“五年后结婚，买房，离家近点。”TA：“我想做架构。”阿姨：“做什么都行，离家近点。”）", "q_oncall": "（阿姨：“三点？三点在睡觉。我不让碰手机。”）（TA 低下了头。）", "q_probation": "（阿姨：“六个月？社保从第一个月交吗？公积金呢？”）", "q_sharp_incident": "（TA：“我上线过一个 bug——”阿姨：“那不怪你，是你们领导没看好。”）", "chief_day12": "（阿姨：“还没有呢。您这儿有合适的，给介绍一下？”）", "chief_sharp_day12": "（TA 刚要开口，阿姨先说了：“打不通就别管了，又不是你的公司。”）（TA：“……我会回滚。”声音很小。）"}
asides = PackedStringArray("（阿姨：“你说啊，在家怎么跟我说的？”）", "（阿姨往 TA 手里塞了一个剥好的橘子。）", "（TA 说话前，先看了一眼阿姨。）", "（阿姨在旁边小声补了一句：“这孩子从小就聪明。”）")
answer_kind = "honest"
ability = 55
honesty = 50
loyalty = 70
pressure = 15
performance = 30
event_override = &"delay"
