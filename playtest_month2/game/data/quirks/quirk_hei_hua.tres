[gd_resource type="Resource" script_class="Quirk" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/Quirk.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quirk_hei_hua"
entrance = "（TA 起身跟你握手，握了两下：“您好，很高兴和贵司对齐一下颗粒度。”这才坐下。）"
answers = {"q_weakness": "我的短板是太追求闭环，有时候颗粒度对齐得过细，影响了整体势能。", "q_tech_depth": "坑，本质上是认知的断层。我通过搭建方法论抓手，把踩坑沉淀为组织资产，形成正向飞轮。", "q_sharp_slow_sql": "慢，是表象。底层是链路没有对齐。我会先拉通 DBA，打通数据孤岛，赋能业务侧。", "q_sharp_slow_sql+": "全表扫描……本质上是缺乏顶层设计。我建议先复盘一下，看看抓手在哪。", "q_sharp_numbers": "提升了 300%，赋能了全链路，打出了一套组合拳。", "q_sharp_numbers+": "P99 是一个颗粒度问题。我们更看重用户的整体心智。", "q_future": "五年后，我希望自己是一个能定义赛道的人。", "q_company": "贵司处在一个很好的生态位，护城河很深，下一步需要的是破圈。", "chief_day13": "学。学习本身就是一种底层能力，是我的第二增长曲线。", "chief_sharp_day10": "我的代码已经沉淀为平台能力，在多条业务线复用，形成了矩阵。", "r_self_eval": "这句话的底层逻辑，是用确定性的执行，对冲不确定的环境，最终沉淀为个人品牌。"}
asides = PackedStringArray("（TA 在空中比划了一个闭环。）", "（“这个点我先拉齐一下。”）", "（TA 说“抓手”的时候，手真的抓了一下。）", "（“我同步一下我的底层逻辑。”）")
answer_kind = "standard"
ability = 25
honesty = 30
loyalty = 50
pressure = 60
performance = 95
event_override = &"delay"
