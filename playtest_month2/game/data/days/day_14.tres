morning_push = "AI 编程助手“码力”正式发布，号称“超过九成程序员”"
boss_mail = "各位家人：\n月底了，这个月的 HC 必须用完，今天面的人直接定。\n核心系统要用 Banyan 重构，JD 我又改了：后端岗要 Banyan 8 年经验。技能栏里写着 Banyan、括号里满 8 年的才算。\n别问我 Banyan 出了几年，我只要结果。\n—— 王总"
coworker_note = "老周的便签：\nIT 的小孟说，Banyan 是 2023 年才开源的。\n我问他那 8 年怎么来的，他说：问王总。\n规则就是规则。写够 8 年的，你就得放。"
bills = [{"id": "tutoring", "label": "孩子英语班", "amount": 60}, {"id": "coding", "label": "孩子编程班", "amount": 40}]
headline = "核心系统线上事故，问题出在开源框架 Banyan"
news_body = "工程师在 GitHub 上提了 issue。框架作者回复：“抱歉，最近在找工作，暂时没空处理。”"
story_echoes = [{"when": "story_chenmo_1:hired", "headline": "核心系统线上事故，二十分钟修复", "body": "修复者是本月入职的后端工程师陈默。周报上，这一条记在组长名下。"}, {"when": "story_chenmo_2:hired", "headline": "核心系统线上事故，二十分钟修复", "body": "修复者是本月入职的后端工程师陈默。周报上，这一条记在组长名下。"}]
family_sms = "老婆：今天还房贷。\n孩子：编程老师说学历不重要，会用 AI 才重要。爸爸你知道 GPT 吗？"
family_sms_by = [{"when": "marriage<-4", "sms": "老婆：房贷扣了。\n老婆：等你忙完这阵，我们谈谈吧。"}, {"when": "savings<300", "sms": "老婆：今晚加班，别等我。\n老婆：到了，在楼下等你。\n老婆：发错了。\n孩子：编程老师说学历不重要，会用 AI 才重要。爸爸你知道 GPT 吗？"}]
sms_flag = "d14_eve"
sms_replies = [{"key": "warm", "label": "这个月辛苦你了。", "marriage": 1}, {"key": "curt", "label": "看到了。", "marriage": 0}, {"key": "silent", "label": "（不回）", "family": -1, "marriage": -1}]
desk_texts = [{"id": "t14_1", "at": 540, "text": "老婆：今天扣房贷。卡里的钱我看过了。", "replies": [{"key": "warm", "label": "钱的事我来想办法。", "marriage": 1}, {"key": "curt", "label": "嗯。", "marriage": 0}]}, {"id": "t14_2", "at": 840, "text": "老婆：孩子用我手机发的：爸爸，结课展示是下周四哦！！", "replies": [{"key": "warm", "label": "爸爸一定到！", "marriage": 1}, {"key": "curt", "label": "知道了。", "marriage": 0}]}]
chief_opener = "Banyan 8 年？我也不知道它出了几年。王总说要，就要。"
chief_need = {"item": "狼性", "note": "月底了，要能冲的。"}
