story_slot = 3
new_postings = Array[ExtResource("jp")]([ExtResource("j_job_backend_v2")])
candidate_mix = {"regular": 70, "laid_off": 20, "changer": 10}
morning_push = "求职者热衷“简历关键词优化”：教程称“照着改，通过率翻倍”"
boss_mail = "各位家人：\nJD 改版了，桌上那份换了新的。这批 HC 是交易组要的，从明天起各组自己提需求、自己派组长来面。从今天起简历先过关键词：技能栏要写全 JD 上的必备技能，一字不差。\n写了一大堆技能的，一看就是网上抄的模板，也不要。\nJD 上我加了一句“有大厂背景优先”。优先就是优先，不是必须。\n—— 王总"
coworker_note = "老周的便签：\n必备技能是 Java、MySQL、Redis，一个字都不能差。JavaScript 不是 Java，SQL 不是 MySQL。\n技能数一数：8 项正好，9 项就算堆砌。\n“有大厂背景优先”看看就行，规则里没它。"
bills = [{"id": "tutoring", "label": "孩子英语班", "amount": 60}, {"id": "coding", "label": "孩子编程班", "amount": 40}, {"id": "checkup", "label": "父亲复查", "amount": 120}]
headline = "教程作者：照着改，通过率翻倍"
news_body = "“系统只认关键词。你会什么不重要，你写了什么才重要。”该教程已有十万人付费。"
story_echoes = [{"when": "story_chenmo_2:reject", "headline": "教程作者：照着改，通过率翻倍", "body": "“系统只认关键词。你会什么不重要，你写了什么才重要。”评论区有人留言：照着改了，还是没过。回复我的是：{reason}"}]
family_sms = "老婆：你爸说复查他自己去，不用你请假。他说你刚换工作。\n孩子：老师说编程班下学期要涨价。"
family_sms_by = [{"when": "d9_eve:warm", "sms": "老婆：你说要陪你爸复查，他高兴了一晚上，嘴上还说不用。\n孩子：老师说编程班下学期要涨价。"}]
sms_flag = "d10_eve"
sms_replies = [{"key": "warm", "label": "我陪他去，请半天假没事。", "marriage": 1}, {"key": "curt", "label": "那让他自己去吧。", "marriage": 0}, {"key": "silent", "label": "（不回）", "family": -1, "marriage": -1}]
desk_texts = [{"id": "t10_1", "at": 540, "text": "老婆：你爸说小刘家今晚要来家里坐坐，你早点回来。", "replies": [{"key": "warm", "label": "好，我准点走。", "marriage": 1}, {"key": "curt", "label": "我尽量。", "marriage": 0}]}, {"id": "t10_2", "at": 860, "text": "老婆：他们拎了好多东西来。我说不要，放下就走了。", "replies": [{"key": "warm", "label": "先放着，我回来处理。", "marriage": 1}, {"key": "curt", "label": "嗯。", "marriage": 0}]}]
home_scene = [{"text": "到家 18:50。你爸也在。茶几上摆着两条烟、一盒茶叶，还有一个信封，里面是一张购物卡，¥800。"}, {"text": "你爸：小刘他们家刚走。他儿子的简历，下礼拜投你那儿。"}, {"text": "你爸：你上回说让他投，人家当真了。", "when": "h5_dad:try"}, {"text": "你爸：你上回说说不上话，人家还是来了。我也不好拦。", "when": "h5_dad:hard"}, {"text": "你爸：小刘说了，烟是给我的，卡是给孩子交学费的，不是给你的。"}, {"ask": "h10_gift", "options": [{"key": "keep", "label": "收下吧。卡先拿去交编程班。", "then": [{"text": "你爸松了口气：“我就说嘛，都是自己人。”"}, {"text": "老婆看了你一眼，进厨房了。"}], "say": "你把购物卡收进了抽屉。", "gray": {"from": "小刘家", "amount": 800, "candidate_id": "story_xiaoliu", "taken": true}}, {"key": "return", "label": "爸，东西退回去。简历我按规矩看。", "then": [{"text": "你爸：你这孩子，我这张老脸往哪搁？"}, {"text": "他把东西一样一样装回袋子里，装了很久。"}, {"text": "老婆送他下楼。回来跟你说，你爸在楼下站了好一会儿。"}], "marriage": 1, "gray": {"from": "小刘家", "amount": 800, "candidate_id": "story_xiaoliu", "taken": false}}]}, {"text": "夜里你想起来，抽屉里还有一个信封，是三月李哲他爸的。他也说是心意。", "when": "took:story_headhunter"}, {"text": "夜里你想起三月李哲他爸那个信封。那个你退回去了。", "when": "!took:story_headhunter"}]
chief_opener = "关键词？我们那时候招人看眼缘。现在都看机器了。"
chief_need = {"item": "格局", "note": "要懂新东西的。"}
