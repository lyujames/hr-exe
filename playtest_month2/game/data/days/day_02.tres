desk_texts = [{"id": "t2_1", "at": 555, "text": "老婆：你爸早上打电话来，说话有点喘。我让他去医院，他说没事。", "replies": [{"key": "warm", "label": "我中午给爸打个电话。", "marriage": 1}, {"key": "curt", "label": "他说没事就没事吧。", "marriage": 0}]}, {"id": "t2_2", "at": 840, "text": "老婆：孩子英语听写全对，非让我告诉你。", "replies": [{"key": "warm", "label": "替我夸夸他！", "marriage": 1}, {"key": "curt", "label": "好。", "marriage": 0}]}]
home_scene = [{"text": "到家 18:50。孩子把英语听写本摊在你拖鞋旁边。"}, {"text": "孩子：一百分！老师在上面画了个星星！"}, {"text": "孩子：妈妈说你让她夸我了。她夸得一点都不像。", "when": "t2_2:warm"}, {"ask": "h2_kid", "options": [{"key": "burger", "label": "真棒，周末带你去吃汉堡。", "marriage": 1, "then": [{"text": "孩子：说好了！拉钩！"}, {"text": "你跟他拉了钩。老婆在厨房门口看了你一眼。"}]}, {"key": "keep", "label": "嗯，继续保持。", "then": [{"text": "孩子：……哦。"}, {"text": "他把本子收回书包里了。"}]}]}, {"text": "老婆：你那句话管用，你爸答应去查了。你说话他听。", "when": "d2_dad:checkup"}, {"text": "老婆：周末？你这个月哪个周末不加班。", "when": "d2_dad:weekend"}, {"text": "老婆：算了，我先陪他去，你别管了。", "when": "d2_dad:weekend"}, {"text": "老婆：你爸的事，你短信也不回。", "when": "d2_dad:silent"}, {"text": "老婆：他是你爸。", "when": "d2_dad:silent"}, {"text": "睡前，你翻到你爸的号码。"}, {"ask": "h2_call", "options": [{"key": "call", "label": "给他打过去。", "marriage": 1, "then": [{"text": "你爸：没事没事，人老了都这样。你刚换单位，忙你的。"}, {"text": "电话那头电视开得很大声。他说话的时候，中间要停一下喘口气。"}], "say": "你拨了过去。"}, {"key": "late", "label": "太晚了，明天再说。", "then": [{"text": "你把手机放回床头。老婆翻了个身。"}], "say": "你没拨。"}]}]
