[resource]
script = ExtResource("1")
day = 12
date = "2026-04-16"
resume_count = 7
screening_seconds = 200.0
new_rules = Array[ExtResource("rule")]([ExtResource("r_rule_self_eval")])
story_candidates = Array[ExtResource("cand")]([ExtResource("s_candidate_mother")])
story_slot = 4
candidate_mix = {"regular": 70, "laid_off": 20, "changer": 10}
morning_push = "某公司倡导“奋斗者文化”：“平衡”是给躺平找借口"
boss_mail = "各位家人：\n新规矩：自我评价里写“平衡”“稳定”的不要。来创业公司求稳定？想平衡就别来。\n只看这两个字，别给我解释上下文。\n—— 王总"
coworker_note = "老周的便签：\n翻到第二页看自我评价，找“平衡”“稳定”两个词。写在技术词里的也算：负载平衡、系统稳定性。\n“均衡”不是“平衡”，“长期”不是“稳定”。\n我闺女说，我这是在帮机器干活。"
bills = [{"id": "tutoring", "label": "孩子英语班", "amount": 60}, {"id": "coding", "label": "孩子编程班", "amount": 40}]
headline = "专家：AI 替代不了程序员，“最多替代不会用 AI 的程序员”"
news_body = "调查称，AI 编程助手在程序员中的使用率已过半。多家公司表示“暂无裁员计划”。"
family_sms = "老婆：今天那个主管又问了一个同事二胎的事。她在厕所哭了。\n孩子：编程老师说，编程要从小学起，不然来不及。"
sms_flag = "d12_eve"
sms_replies = [{"key": "warm", "label": "你那个同事要是想申请仲裁，我帮她看看材料。", "marriage": 1}, {"key": "curt", "label": "职场都这样。", "marriage": 0}, {"key": "silent", "label": "（不回）", "family": -1, "marriage": -1}]
desk_texts = [{"id": "t12_1", "at": 600, "text": "老婆：你们面试的时候，会问人家有没有孩子吗？", "replies": [{"key": "honest", "label": "会。规则里没写，主管会问。", "marriage": 1}, {"key": "deny", "label": "不会，那是违法的。", "marriage": 0}]}, {"id": "t12_2", "at": 850, "text": "老婆：我就问问。", "replies": [{"key": "warm", "label": "晚上回家说。", "marriage": 1}, {"key": "curt", "label": "嗯。", "marriage": 0}]}]
home_scene = [{"text": "到家 19:00。老婆在给孩子检查编程作业，抬头看了你一眼。"}, {"text": "你想起今天那份简历，最后一句是：希望工作和生活能有个平衡。", "when": "story:story_mother:reject"}, {"ask": "h12_wife", "options": [{"key": "tell", "label": "跟她说：今天拒了一个当妈的，因为她写了“平衡”两个字。", "then": [{"text": "老婆半天没说话。"}, {"text": "老婆：她写的是实话。"}], "marriage": 1, "say": "你跟她说了：今天拒了一个当妈的，因为她写了“平衡”两个字。"}, {"key": "skip", "label": "什么都没说，去洗手。", "then": [{"text": "老婆低头接着检查作业。"}], "say": "你什么都没说，去洗手了。"}]}, {"text": "孩子：爸爸，我的小猫会自己找路了！"}, {"text": "孩子：它撞了好多次墙，后来就学会拐弯了。"}, {"ask": "h12_kid", "options": [{"key": "you", "label": "跟你一样，撞几次就会了。", "then": [{"text": "孩子：嗯！"}, {"text": "他又让小猫走了一遍。"}], "marriage": 1}, {"key": "later", "label": "快睡吧，明天再说。", "then": [{"text": "他关了平板，没再问。"}]}]}]
chief_opener = "奋斗者文化，这个好。我们那时候没人提平衡。"
chief_need = {"item": "狼性", "note": "要能拼的，别跟我谈平衡。"}
chief_question = ExtResource("chief_q")
chief_sharp = ExtResource("chief_s")
quirk = ExtResource("quirk")
