headline = "月供压力调查：七成家庭“月底最怕看余额”"
news_body = "受访者称：“工资一到账就转走了，像个过路财神。”"
family_sms = "老婆：今天还房贷。卡里的钱我看过了，你自己看吧。
老婆：孩子说编程班的老师讲，以后程序员最吃香。"
chief_opener = "今天必须定一个。月底了，谁都不想背空着的 HC。"
chief_need = {"item": "狼性", "note": "月底了，要能冲的。"}
chief_question = ExtResource("chief_q")
candidate_ask = ExtResource("chief_a")
desk_texts = [{"id": "t7_1", "at": 540, "text": "老婆：我们部门的名单出来了，我不在上面。先这样。", "replies": [{"key": "warm", "label": "太好了，晚上吃顿好的。", "marriage": 1}, {"key": "curt", "label": "那就好。", "marriage": 0}]}, {"id": "t7_2", "at": 850, "text": "老婆：房贷今天扣，卡里的钱我没动。", "replies": [{"key": "warm", "label": "钱的事我来想办法。", "marriage": 1}, {"key": "curt", "label": "好。", "marriage": 0}]}]
