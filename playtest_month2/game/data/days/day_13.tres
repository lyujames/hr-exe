family_sms = "你爸：复查结果出来了，医生说要按时吃药。药不便宜。\n孩子：爸爸，下周编程班结课展示，你来吗？"
sms_flag = "d13_eve"
sms_replies = [{"key": "warm", "label": "来。请假也去。", "marriage": 1}, {"key": "curt", "label": "看那天忙不忙。", "marriage": 0}, {"key": "silent", "label": "（不回）", "family": -1, "marriage": -1}]
desk_texts = [{"id": "t13_1", "at": 560, "text": "老婆：你爸的药一个月四百多，医保报一半。", "replies": [{"key": "warm", "label": "我来出，你别操心。", "marriage": 1}, {"key": "curt", "label": "知道了。", "marriage": 0}]}, {"id": "t13_2", "at": 830, "text": "老婆：今天公司开会，说下个月可能要“优化”一批人。不知道有没有我。", "replies": [{"key": "warm", "label": "有我在，别怕。", "marriage": 1}, {"key": "curt", "label": "应该不会。", "marriage": 0}]}]
home_scene = [{"text": "你把李哲表哥那个信封塞进公文包最里层。抽屉里三月那个还在。", "when": "took:story_lizhe_cousin&took:story_headhunter"}, {"text": "你把李哲表哥那个信封塞进了公文包最里层。", "when": "took:story_lizhe_cousin&!took:story_headhunter"}, {"text": "到家 18:50。老婆在阳台收衣服，手机在洗衣机上亮了好几次，她都没看。"}, {"text": "老婆：开会说要优化。主管说以后记账都上新系统了，一个人能顶三个。"}, {"text": "老婆：我三十三了。你们 HR 筛人，三十三的会计还要吗？"}, {"ask": "h13_wife", "options": [{"key": "honest", "label": "不好找。但你不会走到那一步。", "then": [{"text": "老婆：你今天筛了几个三十三的？"}, {"text": "你：……没数。"}], "marriage": 1}, {"key": "comfort", "label": "要的，你干得那么好。", "then": [{"text": "老婆：你们的规则里，有“干得好”这一条吗？"}, {"text": "你没回答。"}]}]}, {"text": "孩子从房间探出头：“爸爸，结课展示是下周四！别忘了！”"}]
chief_opener = "90 后好，有冲劲。我 85 年的，我当年也有。"
