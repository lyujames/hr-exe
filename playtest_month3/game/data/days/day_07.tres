desk_texts = [{"id": "t6_1", "at": 550, "text": "老婆：我们部门今天又走了两个，说是“优化”。", "replies": [{"key": "warm", "label": "你还好吗？", "marriage": 1}, {"key": "curt", "label": "现在哪都这样。", "marriage": 0}]}, {"id": "t6_2", "at": 830, "text": "老婆：还好，就是有点怕。你是做 HR 的，你说名单是怎么定的？", "when": "t6_1:warm", "replies": [{"key": "honest", "label": "说实话，看年龄和工资。", "marriage": 1}, {"key": "curt", "label": "别多想，没事的。", "marriage": 0}]}, {"id": "t6_2", "at": 830, "text": "老婆：没事，就是跟你说一声。你忙。", "replies": [{"key": "warm", "label": "晚上回去聊。", "marriage": 1}, {"key": "curt", "label": "嗯。", "marriage": 0}]}]
sms_flag = "d6_eve"
sms_replies = [{"key": "warm", "label": "能，我带他去。", "marriage": 1}, {"key": "curt", "label": "周六我可能加班。", "marriage": 0}, {"key": "silent", "label": "（不回）", "family": -1, "marriage": -1}]
home_scene = [{"text": "你外套口袋里那个信封硌了你一下。进门前，你把它塞进了公文包最里层。", "when": "kickback"}, {"text": "到家 18:50。老婆在厨房，锅里的水开了很久，她没关火。"}, {"text": "你爸在阳台打电话：“……跟他说了，说了。东西先别往家里送，等等再说。”"}, {"text": "看见你进门，他把电话挂了。"}, {"text": "老婆：你白天说，看年龄和工资。我今年三十三，工资在部门里排前三。", "when": "t6_2:honest"}, {"text": "老婆：你们做 HR 的，名单到底是怎么定的？", "when": "!t6_2:honest"}, {"ask": "h6_wife", "options": [{"key": "together", "label": "真到那天，我们一起扛。", "marriage": 1, "then": [{"text": "她把火关了。"}, {"text": "老婆：嗯。"}]}, {"key": "needed", "label": "你们财务离不开你。", "then": [{"text": "老婆：星桥当年也离不开你。"}, {"text": "你没说话。"}]}, {"key": "dunno", "label": "名单又不是我定的，我哪知道。", "marriage": -1, "then": [{"text": "老婆：我没问你定的。我问你怎么定的。"}, {"text": "她把面捞出来，一根一根，捞得很慢。"}]}]}, {"text": "孩子在日历的周六上画了个圈，圈了三层。", "when": "d6_eve:warm"}, {"text": "孩子：爸爸，周六说好了啊！", "when": "d6_eve:warm"}, {"text": "孩子：妈妈说你周六可能加班。那周日呢？", "when": "d6_eve:curt"}, {"ask": "h6_sunday", "options": [{"key": "yes", "label": "周日，爸爸一定去。", "marriage": 1, "then": [{"text": "孩子：拉钩。"}, {"text": "这是这个月第二次拉钩了。", "when": "h2_kid:burger"}]}, {"key": "maybe", "label": "看情况吧。", "then": [{"text": "孩子：你每次都说看情况。"}]}], "when": "d6_eve:curt"}, {"text": "孩子守着妈妈的手机等你回短信，等着等着在沙发上睡着了。手里还攥着试听课的传单。", "when": "d6_eve:silent"}, {"text": "十一点，你把公文包放进柜子。老婆已经睡了。", "when": "kickback"}]
