desk_memos = [{"id": "m22_rule", "at": 480, "printed": true, "title": "桌上的打印件", "text": "【HireBot 规则建议 #001】\n规则：第一学历须为全日制本科。\n依据：本月通过初筛者，第一学历非全日制本科占 100%；该群体定薪低于 JD 下限 21%。\n置信度：0.93　生效：次日 09:00\n本规则由 HireBot 生成。HR 已阅：＿＿＿＿\n\n（夹在后面一张手写的：从明天起这个位置上是打印的。这张是我最后一张手写的。十年经验，三十岁以下，全日制本科。三条放一起，你数数还剩谁。明天 HC 照样要用完。——老周）", "options": [{"key": "read", "label": "签：已阅。", "reply": "你签了。打印件收进了文件夹，抄送王总。"}, {"key": "note", "label": "在旁边写一句“100% 是王总那两条规则筛出来的”，再签。", "reply": "你写了，签了。下午打印件回来了，你那一句旁边，王总画了个圈：“知道了。”", "effects": {"trust": -1, "conscience": 1}}]}, {"id": "m22_wife", "at": 500, "when": "story:story_shenwen:pass", "alarm": true, "title": "王总办公室", "text": "HireBot 关联检测：候选人沈雯的紧急联系人电话与 HR 本人一致。\n王总把屏幕转过来：“亲属应聘，不申报？”", "options": [{"key": "admit", "label": "是我老婆。我没申报，是我的错。", "reply": "王总：“录用作废。下不为例。”", "effects": {"trust": -2, "void": "story_shenwen"}}, {"key": "deny", "label": "我不知道她投了。", "reply": "王总看了你很久：“作废。”", "effects": {"trust": -2, "conscience": -1, "void": "story_shenwen"}}]}, {"id": "m22_table", "at": 520, "when": "w16_table:fudge", "alarm": true, "title": "王总办公室", "text": "HireBot 学信网比对：在职员工学历与 4 月 30 日盘点表不一致 2 处。\n王总：“这两格是谁填的？”", "options": [{"key": "admit", "label": "我填的。", "reply": "王总：“我记着了。”", "effects": {"trust": -2, "conscience": 1}}, {"key": "zhou", "label": "老周填的表。", "reply": "王总：“老周反正月底也走。”", "effects": {"conscience": -2, "flag": {"blamed_zhou": "yes"}}}, {"key": "system", "label": "系统错了吧。", "reply": "王总：“它比我们客观。”", "effects": {"trust": -1}}]}]
desk_texts = [{"id": "w22_voice", "at": 860, "from": "王总", "text": "王总：[语音 60″] 她那个情况你知道，别提名单，就说岗位没了。", "replies": [{"key": "keep", "label": "（长按，收藏这条语音）", "evidence": "voice_22"}, {"key": "ok", "label": "收到。"}]}, {"id": "t22_1", "at": 640, "text": "老婆：今天去了一家面试。对方问我孩子几岁、谁带。", "replies": [{"key": "warm", "label": "这题不该问。你怎么答的？", "marriage": 1}, {"key": "curt", "label": "都这样问。", "marriage": 0}]}]
