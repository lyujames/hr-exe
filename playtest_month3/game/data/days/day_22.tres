exit_talks = [{"id": "han_lei", "name": "韩蕾", "seed": 1992052, "female": true, "info": "数据组组长 · 34 岁\n怀孕五个月", "criteria": "“岗位取消”", "opener": "（韩蕾扶着桌子坐下。她把协议放在肚子前面，没打开。）", "questions": [{"template": "why"}, {"q": "我这个情况，公司能裁我吗？", "options": [{"style": "lie", "label": "不是裁，是岗位取消，协商解除。", "reply": "……岗位取消。好。", "outcome": "signed", "effects": {"lawsuit": 2, "flag": {"han_lei": "lie"}}}, {"style": "safe", "label": "我只负责传达。", "reply": "那我回去问问律师。", "outcome": "refused", "effects": {"flag": {"han_lei": "safe"}}}, {"style": "truth", "label": "不能。孕期公司不能单方面解除。你不签，谁也动不了你。", "reply": "（她看了你很久。）……谢谢。我记住你了。", "outcome": "refused", "effects": {"trust": -2, "conscience": 2, "flag": {"han_lei": "truth"}}}]}], "signed": "韩蕾签了字。谈话人那一栏，写的是你的名字。", "refused": "韩蕾把协议原样放回桌上，扶着桌子站起来，走了。"}, {"id": "r22", "name": "孙立", "seed": 1987022, "info": "后端 · 39 岁 · 大专\n司龄 8 年", "criteria": "“学历不达标”：第一学历大专", "female": false}]
