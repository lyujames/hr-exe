standard = "通过完善的幂等机制和对账体系，保障资金安全。"
flaw = "重复扣款……应该不会吧，银行会退的。"
followup_text = "唯一键建在哪几个字段上？"
honest_followup = "订单号加支付渠道。冲突了不报错，直接返回第一次的结果。"
honest_low_followup = "……订单号？我不太确定。"
standard_followup = "这个要结合具体的表结构来设计。"
flaw_followup = "建、建在用户表上？"
lead_flaw = "银行不退。银行只会找我们。"
