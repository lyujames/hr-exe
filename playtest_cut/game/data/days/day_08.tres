desk_texts = [{"id": "t8_1", "at": 560, "text": "老婆：编程班试听完了，老师说他有天分。就是贵。", "replies": [{"key": "warm", "label": "有天分就报，钱我来想办法。", "marriage": 1}, {"key": "curt", "label": "再看看吧。", "marriage": 0}]}, {"id": "t8_2", "at": 830, "text": "老婆：我们部门新来的领导是 95 年的。开会的时候叫我“姐”。", "replies": [{"key": "warm", "label": "那你就叫他小同志。", "marriage": 1}, {"key": "curt", "label": "习惯就好。", "marriage": 0}]}]
home_scene = [{"text": "到家 18:50。你爸在收拾行李，一件衬衫叠了三遍。"}, {"text": "你爸：下周一我回去了，复查的时候再来。"}, {"text": "你爸：小刘那边，你下个月上点心。他说了，不让你白忙。"}, {"ask": "h8_dad", "options": [{"key": "ok", "label": "下个月我看看。", "then": [{"text": "你爸：这就对了。"}, {"text": "他把衬衫放进箱子，压平。"}]}, {"key": "no", "label": "爸，这事我真办不了。", "then": [{"text": "你爸没说话，把衬衫又拿出来，重新叠了一遍。"}]}]}, {"text": "孩子：爸爸开车送爷爷，我坐副驾驶！", "when": "d8_eve:warm"}, {"text": "老婆：副驾驶是爷爷的。", "when": "d8_eve:warm"}, {"text": "孩子：高铁快还是爸爸的车快？", "when": "d8_eve:curt"}, {"text": "你爸：高铁快。", "when": "d8_eve:curt"}, {"text": "孩子在门口等了一会儿，问妈妈爸爸回短信没有。", "when": "d8_eve:silent"}, {"text": "睡前，老婆说：“明天月底了。”你说：“嗯，还房贷。”"}]
