boss_mail = "各位家人：\n五一过完了，降本增效进入第二阶段。程序员 HC 减半，空出来的活交给“码力”。\n从今天起只招一个岗：高级全栈工程师，JD 在桌上。前端、后端、运维一个人包，本岗位不配初级工程师。\n要求就两条：工作满 10 年；1996 年以后出生。要老手的经验，也要年轻人的身体。别跟我说这两条打架，市场上有的是人。\n初筛系统升级了，现在叫 HireBot，每份简历上给一句建议。它是来帮你的。\n共克时艰，全员底薪下调 20%，详见日结单。\n我们是一家人。\n—— 王总"
coworker_note = "老周的便签（三楼）：\n年限看第一页，含实习、含兼职的不算；年龄看身份证，1996 年及以后。\n两条都够的，十七八岁就上班了。\n成人教育的证照样算本科。\n三楼的名单下去了。表是我填的。"
bills = [{"id": "tutor_1v1", "label": "孩子英语一对一", "amount": 60}, {"id": "ai_class", "label": "AI 创想课", "amount": 30}, {"id": "meds", "label": "父亲药费", "amount": 40}]
desk_texts = [{"id": "t17_1", "at": 560, "text": "老婆：节后第一天，公司群里一上午没人说话。", "replies": [{"key": "warm", "label": "没事，有我。", "marriage": 1}, {"key": "curt", "label": "正常，节后都这样。", "marriage": 0}]}, {"id": "t17_2", "at": 800, "text": "老婆：今天你能准点下班吗？孩子说有事要跟你说。", "replies": [{"key": "warm", "label": "能。今天没有面试。", "marriage": 1}, {"key": "curt", "label": "看情况。", "marriage": 0}]}]
home_scene = [{"text": "18:00 准点下班。这个月唯一一次。"}, {"text": "到家 18:50。孩子在门口等你。"}, {"text": "孩子：编程班改名了，叫 AI 创想课。老师说以后不用学写代码了，要学怎么跟 AI 说话。"}, {"text": "孩子：今天 AI 直接把路告诉小猫了。它一次墙都没撞。"}, {"ask": "h17_kid", "options": [{"key": "learned", "label": "那它算学会了吗？", "marriage": 1, "then": [{"text": "孩子想了很久：“……是 AI 学会了。”"}]}, {"key": "easy", "label": "挺好，省事。", "then": [{"text": "孩子：“老师也这么说。”"}]}]}, {"text": "老婆：英语大班停了。老师私下开一对一，一次贵二十。"}]
