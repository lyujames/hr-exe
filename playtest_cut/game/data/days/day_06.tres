story_echoes = [{"when": "story_perfect:exposed", "mail_ps": "PS：晚报上卷钱跑的顾全，面试时是你问出毛病的。干得好，特批奖金今天发。", "bonus": {"label": "王总特批：识破顾全", "amount": 200}}, {"when": "story_perfect:seen&!story_perfect:hired&!story_perfect:exposed", "mail_ps": "PS：晚报上卷钱跑的顾全，第一天投过咱们，没进咱们的门。特批 ¥50，算你运气，也算你眼光。", "bonus": {"label": "王总特批：没招顾全", "amount": 50}}, {"when": "story_philosophy:reject", "headline": "一篇推文刷屏：《凌晨四点的外卖站》", "body": "作者苏见青，哲学系大三，现为某竞品公司内容运营实习生。她说：“谢谢每一个拒绝过我的公司。”", "mail_ps": "PS：竞品那篇外卖站的推文看了吗？咱们怎么就招不到这种人？"}]
family_sms = "老婆：你爸下午在阳台打电话，打了快一个钟头。
