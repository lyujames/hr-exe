candidate_ask = ExtResource("chief_a")
desk_texts = [{"id": "t6n_1", "at": 560, "text": "老婆：你爸说住咱家给我们添麻烦，非要回去。我劝住了。", "replies": [{"key": "warm", "label": "让他安心住着，晚上我跟他说。", "marriage": 1}, {"key": "curt", "label": "他想回就让他回吧。", "marriage": 0}]}, {"id": "t6n_2", "at": 820, "text": "老婆：孩子数学测验 92，说要等你回来签字。", "replies": [{"key": "warm", "label": "签！我早点回。", "marriage": 1}, {"key": "curt", "label": "你签就行。", "marriage": 0}]}]
home_scene = [{"text": "到家 18:50。你爸坐在沙发上看新闻，声音开得很大。"}, {"text": "孩子把卷子举到你面前：“签这儿！”", "when": "t6n_2:warm"}, {"text": "你签了名。他把卷子折了两折，塞进书包最里层。", "when": "t6n_2:warm"}, {"text": "卷子在茶几上，签名那栏已经是老婆的字了。", "when": "!t6n_2:warm"}, {"text": "你爸：小刘今天又打电话了。问你们公司下个月招不招正式的。"}, {"ask": "h6n_dad", "options": [{"key": "later", "label": "下个月的事，下个月再说。", "then": [{"text": "你爸：他说了，到时候让孩子直接投你。"}, {"text": "你爸：人家懂规矩。"}]}, {"key": "rules", "label": "爸，招人有规矩，我不能看是谁家的。", "then": [{"text": "你爸：规矩是人定的。"}, {"text": "他把电视声音又调大了一格。"}]}]}, {"text": "睡前你问你爸，下午那通电话怎么打了那么久。", "when": "d6n_eve:warm"}, {"text": "你爸：老刘，叙叙旧。", "when": "d6n_eve:warm"}, {"text": "他说这话的时候，没看你。", "when": "d6n_eve:warm"}, {"text": "十点，老婆对着日历数了数：“这个月还有三天。”"}]
