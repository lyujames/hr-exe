home_scene = [{"text": "到家 19:50。她把协议摊在桌上。"}, {"text": "老婆：N+1。他们 HR 说：“这是对你最好的安排。今天签，多给半个月。”"}, {"text": "这句话，你今天下午念过。", "when": "talk_own_hire:signed|talk_r19:signed"}, {"ask": "h19_wife", "options": [{"key": "full", "label": "基数不对，该按前十二个月平均算。明天我陪你去谈。", "marriage": 1, "then": [{"text": "老婆：……你怎么连这个都知道？"}, {"text": "你：我每天都在算别人的。"}]}, {"key": "base", "label": "差不多就签吧，闹僵了以后背调不好看。", "then": [{"text": "老婆：你是在劝我，还是在劝今天下午那几个人？"}]}, {"key": "same", "label": "这套话我今天也念了。", "marriage": 1, "then": [{"text": "老婆很久没说话。"}, {"text": "老婆：那他们签了吗？"}]}]}]
