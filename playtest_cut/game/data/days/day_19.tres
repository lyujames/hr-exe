exit_talks = [{"id": "own_hire", "criteria": "“学历不达标”", "female": false, "variants": [{"when": "story:story_chenmo_1:hired|story_chenmo_2:hired|story_chenmo_3:hired", "name": "陈默", "seed": 19960914, "info": "内部系统组 · 4 月入职\n第一学历：高中", "criteria": "“学历不达标”：第一学历高中，自考还差两门", "opener": "（陈默坐下，没看协议。第一批名单的抬头写着：学历不达标人员。）", "replies": {"why_lie": "行。", "why_safe": "行。", "why_truth": "……学历。行。", "comp_lie": "行。", "comp_safe": "（他没翻第二页。）行。", "comp_truth": "……行。我回去算。"}, "questions": [{"template": "why"}, {"template": "comp"}, {"q": "Banyan 那个事故单，以后谁接？", "options": [{"style": "lie", "label": "会有专人跟进的。", "reply": "（他点点头。他知道没有专人。）"}, {"style": "safe", "label": "这个不归我管。", "reply": "嗯。"}, {"style": "truth", "label": "没人。系统交给码力。", "reply": "码力是照着我的代码训练的。……那它应该接得住。", "effects": {"conscience": 1}}]}], "signed": "陈默签了字。走到门口他回头：“报销系统每个月 25 号会卡一次，重启就好。没人会问你，我先告诉你。”", "refused": "陈默把协议推回来：“我不签。不是因为钱。”"}, {"when": "story:story_chengye:hired|story_chengye_fx:hired", "name": "程野", "seed": 4401, "info": "后端 · 4 月入职\n工作年限（含实习）", "criteria": "“工作年限不达标”：含实习那 8 个月不算", "opener": "（程野坐下，手里攥着工牌。）我才来一个月。"}, {"when": "story:story_fresh_genius:hired", "name": "宋知遥", "seed": 4402, "info": "后端 · 4 月入职\n工作年限 1 年 10 个月", "criteria": "“工作年限不达标”"}, {"when": "hired_month:2", "name": "{hire_name}", "seed": 4403, "info": "4 月入职 · 你招进来的", "criteria": "“学历不达标”", "opener": "（{hire_name} 坐下。你认得这张脸：上个月你面过 TA。）"}]}]
