exit_talks = [{"id": "lao_zhou", "name": "老周", "seed": 1979047, "female": false, "info": "行政 / 人事 · 47 岁 · 大专\n司龄 12 年", "opener": "（老周进门就说：）话术不用念了，那是我写的。（他把协议推过来。）算式我替你填好了。你签个字就行。", "sheet": "经济补偿：N+1（12+1 个月）\n计算基数：¥6,200（降薪后）\n——这一格是他自己填的。\n\n甲方（盖章）：蜂巢科技\n乙方（签字）：周建国", "questions": [{"q": "（他等你签字。）", "options": [{"style": "safe", "label": "照他填的签。", "minutes": 2, "reply": "他点点头。“写了十二年，轮到自己，手还是照着写。”"}, {"style": "truth", "label": "把基数改回来，按前十二个月的平均重算。", "minutes": 12, "reply": "他看着你改。“……多两个月。行。”他没说谢谢。", "effects": {"fine": 100, "trust": -1, "conscience": 1, "flag": {"zhou_helped": "yes"}, "evidence": "zhou_book"}}]}, {"q": "我闺女那个章，我记着。", "when": "story:story_zhou_daughter:exception", "options": [{"style": "safe", "label": "（你没说话。）", "minutes": 1, "reply": "他从包里拿出一本手抄的本子，放进你抽屉里。", "effects": {"evidence": "zhou_book"}}]}], "after_signed": {"flag": {"zhou_left": "yes"}}, "signed": "走之前他说：“便签我写到今天。以后桌上那张是打印的，错了别怪我。”", "refused": ""}]
candidate_ask = ExtResource("ask23")
chief_opener = "月底了，凑满三个。规则？规则是 HireBot 的。"
desk_memos = [{"id": "m23_private", "at": 720, "when": "kickback", "title": "WChat　李哲他爸", "text": "李哲他爸：兄弟，有个私活。一份简历，按你们那边的口味改一改，过了初筛就行。一个人头三百，当天结。\n（他发来一份简历。第一行你就知道它会卡在哪。）", "options": [{"key": "take", "label": "改。收款。", "reply": "你改了四处。十分钟后，¥300 到账。收款是你自己点的。", "minutes": 10, "effects": {"gray": {"from": "李哲的爸爸", "amount": 300, "candidate_id": "private_23"}}}, {"key": "pass", "label": "不接。", "reply": "李哲他爸：行。月底了，你自己掂量。"}]}]
