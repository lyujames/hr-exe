answers = {"q_intern_role": "写东西，让人愿意看完。剩下的拉群、盯数据，我可以学。", "q_project": "外卖站那篇，我凌晨四点在站点蹲了一周。每个字都是我自己的。", "q_our_app": "用过。推送文案像说明书，没人会点开。我改写了三条，夹在简历后面。", "q_data_test": "（算了很久，算对了。）我会算，只是慢一点。", "q_chores": "能。拿快递的路上也能想选题。", "q_schedule": "大三课少，每周五天都能来。", "q_return_offer": "那我就带着在这儿写的东西去下一家。", "q_friday": "先回“在”。哲学没教我怎么拒绝领导。", "q_weakness": "专业。您的手册上写着。", "chief_intern_job": "听说什么都干。我只怕没东西可写。", "chief_weekend": "可以。写东西本来就没有周末。", "chief_thesis": "大三，还没有论文。能干满一年。", "q_intern_role+": "先问这群人为什么要进来。想不清楚这个，拉多少人都会退群。然后写第一条群公告，写到我自己愿意看完为止。复盘时我会把退群的人一个个看一遍，看他们是在哪条消息之后走的。", "q_project+": "我自己数的。一周，每天凌晨四点到七点，进出站一百三十七人次，三十六个骑手，跟其中九个聊过。文章阅读一万二，四百多条留言，大部分是骑手留的。", "q_our_app+": "第一条“您有一张优惠券即将过期”，我改成“你那张券，明天就作废了”。少了六个字，多了一个人。另外两条也夹在后面，您可以对着原文看。", "q_chores+": "那我会把这个月打过的杂都记下来，月底写一篇。不是抱怨，是想知道一个新人在这儿的第一个月看到了什么。写完先给您看。", "q_schedule+": "（TA 把课表递过来。）周一早上一节、周三下午一节，都是选修，老师不点名。我还是会去，下了课再过来。", "q_return_offer+": "至少两周，我会当面说。不会让您从别人那儿听说。", "q_friday+": "上学期，辅导员周五晚上十一点让改一篇稿。我回了“在”，改到一点。第二天他说，还是用第一版吧。", "q_weakness+": "上周。另一家的面试官看了专业，问哲学能干什么。我说能把一件事想清楚再说出来。他笑了，说那我们不需要。"}
epilogue = {"hired": "你放了她。她写的第一条推送，王总转进了全员群。", "pass": "你放了她，面试后没录用。她去了竞品公司。", "reject": "你回她：“{reason}”。当晚的报纸登了她的话。"}
is_story = true
