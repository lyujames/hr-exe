answers = {"q_intern_role": "跑数、做表、写周报。我学电商的，跑数做表是基本功。", "q_project": "数学建模那次，模型是我搭的，论文是队友写的。", "q_our_app": "用过。在医院走廊等的时候刷的，签到页要加载八秒。", "q_data_test": "（三分钟算完，顺手把表头的一个错标了出来。）", "q_chores": "能。跑腿我习惯了，最近天天在医院跑。", "q_schedule": "课不多。周二、周四要去医院，另外三天全天都在。晚上的活我在病房也能做。", "q_return_offer": "那就等我爸出院，再找下一份。", "q_friday": "我会回。在病房里也会回。", "q_weakness": "每周只能来三天。我知道这是硬伤。", "chief_intern_job": "知道，杂活多。我能干。", "chief_weekend": "周末可以。周末有我妈在医院。", "chief_thesis": "能，一年都能。只是每周三天。", "chief_exam": "我提前复习，考试那几天晚上补。", "q_intern_role+": "先看上一次的数据：哪个渠道来的人最多，哪一步掉得最多。拉群之前先把要盯的三个数定下来，不然复盘的时候不知道跟什么比。这样的表我在病房做过一份，是等检查结果的时候做的。", "q_project+": "数据是竞赛给的，四千多条，缺的值是我一条条补的。模型跑了十一版，第九版最好，论文里写的就是第九版。", "q_our_app+": "签到页先把按钮放出来，别等积分和广告都加载完。我在走廊里试过，先能点签到、其余后加载，能省六秒。在那儿等的人，手里一般还拎着东西。", "q_chores+": "那就打一个月杂。我爸住院这两个月，挂号、拿药、跟护士交班都是我，没有人说那是杂活。", "q_schedule+": "不是课，是医院。周二、周四复查换药，这是排班单。（TA 把一张折过好几次的纸推过来。）医生说出院以后就不用了，大概两个月。", "q_return_offer+": "至少一个月。上一份兼职我也是提前一个月说的，手上的表交接完才走，那时候我爸刚住院。", "q_friday+": "上个月，老师周五晚上十点在群里让改数据。我在病房，护士不让开灯，我借着走廊的光改完，十二点发过去。他第二天中午才看。", "q_weakness+": "上个月。实验室的项目我说好周三交，那天我爸进了急诊，晚交了两天。老师没说什么，可下一个项目没叫我。"}
epilogue = {"hired": "你放了她。周二、周四她的工位空着，周报照样第一个交。", "pass": "你放了她，面试后没录用。她在病房里又投了十几份。", "reject": "你回她：“{reason}”。那天晚上，你家里也来了电话。"}
is_story = true
