answers = {"q_weakness": "不太会说话。面试一般到这一步就没了。", "q_tech_depth": "精通不敢说。Banyan 的调度器我重写过三遍，第一版有个死锁，两万个项目一起挂。", "q_tech_depth+": "有人在 issue 里贴了线程 dump。我那天在医院陪我妈，用手机看的，凌晨四点修完。", "q_leaving": "没离开。一直在维护，只是没人发工资。", "q_ai_tool": "用过。它写 Banyan 的用法比我写的文档还熟。它是拿我的代码学的。", "q_ai_tool+": "上个月有人用它生成了一个 PR，删了我一半的测试。我没合。", "q_company": "你们核心系统跑的是 Banyan 1.4，有个已知的内存泄漏，我在 1.6 修了。你们没升。", "q_company+": "你们日志里每天凌晨两点会有一串 GC 告警。就是那个。", "q_future": "五年后 Banyan 可能没人用了。我还在写别的。", "q_oncall": "Banyan 的 issue 是全世界的时区。我没有凌晨三点。", "q_sharp_banyan": "那是我写的。偷活那段锁我改过三次，第二次改出了你们 1.4 里那个内存泄漏。", "q_sharp_banyan+": "WorkStealer，第 212 行。那行注释里有我的名字，你们可以去看。", "q_sharp_incident": "调度器第一版的死锁。两万个项目一起挂，那把锁是我写的。", "q_sharp_incident+": "没人给我定级。复盘写在 issue 里，三百多条回复，一半在骂我。最后一条是我写的：修好了。", "r_edu": "高中，东江三中。后面的都是自己学的。", "r_job:1": "外包三年，写银行的报表系统。我走的时候它一天跑四万张报表，现在应该还在跑。", "r_job:0": "没人发工资的那种维护。Banyan 的 issue 我一个人回，一年两千多条。", "r_self_eval": "代码在 GitHub 上。您可以现在就打开看。", "r_self_eval+": "没人给我打绩效。star 一万二，算吗？", "q_weakness+": "上周。另一家的面试官问我为什么没考大学。我想了很久，他说“好，下一个问题”。我其实已经想好了，没来得及说。", "q_oncall+": "上个月。一个德国用户凌晨两点提了 issue，生产环境死锁。我看了他贴的日志，四点交了修复，他那边下午合进去了。没人叫我，我自己醒的。"}
epilogue = {"hired": "你录用了他。定薪那天王总说：没学历，按 8k 走。他说行。", "pass": "你放了他。违规单上写着：应拒绝：学历要求。", "reject": "你回他：“{reason}”。那个 GitHub 链接，你没点开。"}
id = &"story_chenmo_1"
