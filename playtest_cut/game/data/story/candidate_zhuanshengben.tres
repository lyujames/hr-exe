answers = {"q_intern_role": "拉群、写文案、盯数据，再加上您说的杂活。学院公众号我做了两年，杂活我熟。", "q_project": "公众号是我一个人做的：选题、排版、半夜回留言。粉丝从三百涨到四千。", "q_our_app": "用过。搜“奶茶”出来一堆健身课，我截了图，记在本子上。", "q_data_test": "（算得很快，又从头验了一遍。）百分之三十一点二。", "q_chores": "能。我在食堂打过两年工，比这累。", "q_schedule": "下周开学，课表我带来了。周一下午、周四上午有课，其余都能来。", "q_return_offer": "那我回去好好读本科。两年后再投一次，到时候学历就够了。", "q_friday": "先回“在”，再看是什么事。", "q_weakness": "学历。再过一周就不是了。", "chief_intern_job": "打杂、跑腿、加班。我都做好准备了。", "chief_weekend": "可以。周末我本来也在兼职。", "q_intern_role+": "先看上一次活动的留言，大家问得最多的是什么，群公告先把它答了。拉群的时候我会建个表，谁拉进来的、哪天进的，复盘时就知道哪个渠道有用。公众号涨粉那会儿，我就是这么记的。", "q_project+": "公众号后台导的。两年发了一百八十多篇，粉丝从三百一十二涨到四千零六十。涨得最多的是迎新那周，一天涨了六百，那篇是我在宿舍熬到三点排出来的。", "q_our_app+": "搜索先按我在哪儿、搜的是什么来排，别按谁投的广告多。本子上我记了七个这样的词：奶茶、打印、理发……搜出来都不对。您要的话，我撕下来给您。", "q_chores+": "一个月也行。食堂那两年，第一学期我只洗碗，第二学期阿姨让我上窗口打菜。杂活干得好，会有人看见。", "q_schedule+": "（TA 把课表推过来，周一下午、周四上午用红笔圈着。）就这两个。周四上午那门我问过了，可以跟晚上的班一起上。", "q_return_offer+": "提前一个月。走之前我会把怎么做的、哪些事要盯着写下来，下一个人照着做就行。然后回去读本科，两年后再来。", "q_friday+": "上学期，周五晚上十一点，团委老师说第二天早上要发推送，稿子还没写。我回了“在”，写到两点，排版到三点半，早上七点发出去。那篇阅读两千多。", "q_weakness+": "上周。我投了十几家，大部分写着“本科及以上”，连面试都没有。您这儿是第一家叫我来的。"}
epilogue = {"hired": "你放了她。开学那天，她在工位上给你看了学生证。", "pass": "你放了她，面试后没录用。她开学了。", "reject": "你回她：“{reason}”。下周一她就是本科生了。"}
is_story = true
