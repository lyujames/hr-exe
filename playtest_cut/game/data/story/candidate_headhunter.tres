answers = {"q_project": "小程序是我们组做的。我爸说，写上去显得全面。", "q_chores": "能。我爸说，实习就是先把关系处好。", "q_return_offer": "我爸说，他会再想办法。", "q_project+": "（TA 掏出手机翻了一会儿。）数据……是组长拿的，具体多少条我得问一下。我主要负责做 PPT。我爸说，PPT 也很重要。", "q_chores+": "一个月……（TA 看了一眼手机。）我爸说，打杂的时候要多跟领导吃饭。您这边一般周几聚餐？", "q_return_offer+": "提前多久……这个我爸会跟您这边的人说。（TA 停了一下。）是谁我也不知道，他没跟我讲。"}
epilogue = {"hired": "录用了。他爸给王总也送了一盒茶叶，王总说你会办事。", "pass": "你放了他，面试后没录用。他爸打电话到前台，问是谁面的。", "unbooked": "你放了他，那天晚上约的是别人。他爸打电话到前台，问简历是谁看的。", "reject": "你拒了他：“{reason}”。他一条规则都没违反。"}
is_story = true
