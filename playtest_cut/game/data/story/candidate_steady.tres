major = "广告学"
gpa = 3.06
projects = [{"name": "校园二手交易小程序", "role": "成员", "start": "2024-09", "end": "2026-02"}, {"name": "支教社会实践", "role": "志愿者", "start": "2025-07", "end": "2025-08"}]
intern_days = 5
intern_months = 8
salary_k = 0
jobs = []
self_eval = "二手小程序里我管用户群：三个五百人的群，每条投诉我都回过。投诉最多的是“砍价不回”，我加了个自动提醒，卖家回复率从三成涨到七成。"
attachment = "用户群投诉分类表（手写，附后）。"
portrait_seed = 20260303
event_line = "王总在后面又加了一句：“新来的实习生方晓，用户群凌晨一点还在回投诉，一条没漏。这种人实习期满给她转正。”"
ability = 80
honesty = 90
loyalty = 75
pressure = 65
performance = 70
answers = {"q_project": "小程序不是我写的，我是管群的。每天晚上十点我把当天的投诉抄一遍，分成五类，这张表我带来了。", "q_project+": "最难的一次是有人在群里刷单，假发货、真收钱。我连着三个晚上两点睡，一个个对聊天记录，踢了四十多个号。被骗的那几个同学，我挨个帮他们找卖家要回了钱。", "q_chores": "能。拿快递我会顺手记一下谁的件放了几天没取，订会议室我会提前一天再确认一遍。小事做漏了，大事也不会有人交给你。", "q_weakness": "慢。我回一条投诉要先把前因后果问清楚，所以别人一晚上回五十条，我回二十条。但我回过的，没有再来投诉第二次的。", "q_return_offer": "那我也把交接文档写完再走。群我是怎么管的、哪些卖家要盯着，写清楚，下一个人不用从头摸。", "q_intern_role": "运营实习，我理解就是替用户把那些没人管的小事管起来。比如投诉没人回，就是我的事。", "q_friday": "回。先回“在”，再问是什么事。真要今晚弄完的，我就弄完。", "q_chores+": "那这个月我就把杂活做成表：谁的快递放了几天、哪个会议室老被占着不用。月底交给行政，下个月就能少一半。", "q_weakness+": "上周。一个卖家投诉买家砍价不回，我问了四十分钟，最后发现是他自己把消息提醒关了。那天群里另外二十条，我一条都没回上。", "q_return_offer+": "至少两周。交接文档我会先写好，写完再说走。上回换群主，我也是这么交的。", "q_intern_role+": "先进群看一周，看大家都在骂什么。骂得最多的那件事，就是活动要解决的。拉群前把它写成一句话，复盘的时候就对着这句话看，解决了没有。", "q_friday+": "上个月，周五晚上十点半，群主说小程序支付挂了，让我先稳住群。我发了公告说在修，然后挨个私聊下了单没付成的人，回到一点。第二天修好，我又在群里发了一遍。"}
epilogue = {"hired": "你录了她。第一周她就把用户反馈分好类贴在工位隔板上，她管的群，投诉没有一条过夜。月底，王总在全员群里宣布：方晓转正。", "pass": "你约了她，面试后没录用。她去了一家做二手交易的公司，接着管群。", "unbooked": "你放了她，那天晚上你约的是别人。她去了一家做二手交易的公司，接着管群。", "reject": "你拒了她：“{reason}”。她哪条规则都没违反。"}
is_story = true
