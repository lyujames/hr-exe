[gd_resource type="Resource" script_class="Candidate" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/Candidate.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"story_steady"
display_name = "方晓"
applied_position = "产品运营实习生"
birth_date = "2004-08-21"
degree = 2
school = "西川财经大学"
skills = PackedStringArray("社群运营", "Excel", "问卷星", "剪映")
