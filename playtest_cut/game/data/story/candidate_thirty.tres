answers = {"q_intern_role": "写推送、起标题、回评论。我当了三年老师，一天批四十篇作文，标题写得好不好我一眼能看出来。", "q_project": "公众号是我一个人做的。学院领导嫌标题太“网感”，阅读量是之前的五倍。", "q_our_app": "用过。我在你们 App 上订过家教课，后来那几个老师都转行了。", "q_data_test": "（算了很久，算对了。）数字我不熟，但我肯学。", "q_chores": "能。当老师的时候，复印、排座位、收班费，都是我。", "q_schedule": "研二了，课都修完了。五天都能来。", "q_return_offer": "那我回去写论文。三十一岁了，我不怕再从头来一次。", "q_friday": "回。当老师的时候，家长半夜十二点也发。", "q_weakness": "专业。我知道“学科教学”四个字，在你们这儿是什么意思。", "q_grad_why_ops": "教培没了，讲台也没了。我会的只有写字，和让人愿意听下去。", "q_grad_research": "研究中学生作文怎么评分。说白了，就是什么样的文字让人想读完。", "q_grad_advisor": "导师知道。她说，能出去就出去，别等。", "q_grad_phd": "不读了。我三十一了，想先挣钱。", "chief_exam": "研二没有期末考试了。", "chief_intern_job": "知道，杂活多。我教过书，杂活我熟。", "q_intern_role+": "先想清楚这群人进来想听什么。备课也是这样，先知道学生卡在哪儿，再写教案。活动发出去，我会像改作文一样把评论看一遍，哪句话被人截图转走了，下次就照着那个写。", "q_project+": "后台导出来的。我接手前一年平均阅读两百，我做的那一年平均一千一，最高四千三，写的是毕业生在食堂吃的最后一顿。领导嫌标题网感，可那篇他转了。", "q_our_app+": "课程页先放老师上过的真课片段，别放证书。家长挑老师看的是这个人怎么说话，我当年就是这么被挑中的。那几个老师，现在都在找下一份工作。", "q_chores+": "那就打一个月。我当班主任的时候，开学第一个月全是杂事，可就是那个月，我把四十个孩子的名字和家长电话全记住了。打杂的人知道得最多。", "q_schedule+": "（TA 把教务系统的截图推过来。）学分修满了，只剩论文。导师一周见一次，周四晚上，不占白天。", "q_return_offer+": "至少一个月。教书的时候学生要换老师，我都提前一个月跟家长说。", "q_friday+": "培训班还在的时候，一个家长周五夜里十二点发来一段六十秒语音，问孩子作文为什么只有四十二分。我听完，写了三百字回过去，一点才睡。下一次那孩子考了四十八。", "q_weakness+": "上个月。一家公司的系统直接把我筛掉了，理由写的是“专业不匹配”。我没见到人。今天是第一次有人当面问我。", "q_grad_why_ops+": "那我也来这儿。算法岗要会写代码的人，我不会。我不想去一个只能坐着听的地方。", "q_grad_research+": "我统计过两百多篇作文，老师给高分的，第一段几乎都在一百字以内，里面有一个具体的人。推送也一样：开头一百字里没有人，后面就没人看了。", "q_grad_advisor+": "（TA 从包里拿出一张盖了章的表。）带了。她签字那天还说，签了就别回头。", "q_grad_phd+": "她劝过，在我刚入学的时候。我说考虑一下，考虑了一年，还是不读。她就没再提。"}
epilogue = {"hired": "你放了他，王总也点了头。他的第一篇推送，阅读量是号上的第一。", "pass": "你放了他，面试后没录用。他把专业那栏改成了“汉语言文学（本科）”，接着投。", "unbooked": "你放了他，那天晚上约的是别人。他把专业那栏改成了“汉语言文学（本科）”，接着投。", "reject": "你回他：“{reason}”。他本科学的就是汉语言文学，那一行写在小字里。"}
is_story = true
