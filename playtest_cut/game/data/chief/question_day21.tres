standard = "钱不是最重要的，我更看重平台和成长。"
flaw = "能、能，多少都行。"
followup_text = "那要是下个月再降呢？"
honest_followup = "那我就走。这话我现在说，比以后说好。"
honest_low_followup = "……那就再降吧。"
standard_followup = "我相信公司会给奋斗者回报。"
flaw_followup = "再、再降……也行。"
chief_item = "稳定性"
chief_standard = "看重平台，好。"
chief_honest = "还没进来就谈条件。"
