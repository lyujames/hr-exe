standard = "8 年，它刚出来我就开始用。"
flaw = "七、八年？……挺久了，挺久的。"
followup_text = "那它 1.0 是哪年出的？"
honest_followup = "2023 年 3 月。作者一个人写的，GitHub 上叫 silentchen。"
honest_low_followup = "……不知道。"
standard_followup = "具体年份记不太清了。"
flaw_followup = "一、一点零……好多年前了。"
chief_item = "格局"
chief_standard = "8 年，好，就要这样的。"
chief_honest = "三年？JD 上写的 8 年。"
