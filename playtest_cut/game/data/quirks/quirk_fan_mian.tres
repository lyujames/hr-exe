[gd_resource type="Resource" script_class="Quirk" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/Quirk.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quirk_fan_mian"
entrance = "（TA 坐下，掏出一张打印好的表推到你面前：“我也有几个问题。咱们轮着来，您问一个，我问一个。”）"
answers = {"q_company": "我查过。你们核心系统还跑在 Banyan 1.4 上，凌晨两点有一串 GC 告警。我想问：你们知道吗？", "q_company+": "那就是不知道。没关系，我来了可以修。", "q_overtime": "我先问一句：你们上个月加班的，有几个人报了加班费？", "q_future": "五年后我在哪，取决于你们五年后还在不在。你们去年融到钱了吗？", "q_weakness": "不太给人留面子。比如现在。", "q_family": "一家人的话，我能看家里的账吗？", "q_sharp_slow_sql": "先看执行计划，再看是谁改了字段类型——一般是没走评审的那次上线。你们有上线评审吗？", "chief_day10": "弹性的意思是早上可以晚来？那晚上能早走吗？——不能，那就不叫弹性。", "chief_day15": "学。不过我想先问：你们现在这个框架是谁定的？他还在吗？", "r_edu": "学校教的我基本忘了。我想问一下，你们招人看学历，是因为分不出好坏吗？", "q_weakness+": "上周。组长让我在评审会上“说两句”，我说这个方案上线第一周就会回滚。第三天回滚的。后来评审会他没再叫我。", "q_sharp_slow_sql+": "看 key 是不是空的、possible_keys 里有没有。有索引没走，多半是隐式转换：字段改成了 varchar，代码里传的还是数字。改回来或者改代码，EXPLAIN 再跑一遍，rows 下来了才算完。……这题是哪本面经上的？"}
asides = PackedStringArray("（TA 在自己那张表上打了个分。）", "（“好，记下了。下一个该我问了——算了，您先。”）", "（TA 看了眼赵主管的手机，又在表上写了一笔。）", "（“这个问题问得不错。”TA 说。）")
answer_kind = "honest"
ability = 85
honesty = 85
loyalty = 30
pressure = 70
performance = 40
event_override = &"praise"
