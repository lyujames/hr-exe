honest_low = "钱不够，哪边给得多我去哪边。"
standard = "寻求更大的平台。"
flaw = "那个……平台，对，寻求更大的平台。"
chief_item = "稳定性"
chief_standard = "我们平台确实大。"
chief_honest = "这个……记一下。"
chief_flaw = "平台好。平台大。"
male = {
"honest": "被裁了。整个组一起。",
"honest_low": "钱不够。房贷压着，哪边给得多我去哪边。",
"standard": "想找更大的平台，往管理方向走。",
"flaw": "那边……天花板太低，我在那儿有点屈才。"
}
female = {
"honest": "被裁了。组里走了三个，三个都是女的。……可能是巧合。",
"honest_low": "钱不够。而且我在那儿升不上去，组长说我“稳”，稳的人不用升。",
"honest_low_mom": "休完产假回去，岗位给别人了，让我去做行政。",
"standard": "想找一个更稳定的平台，长期发展。",
"flaw": "就……想换个环境。没、没什么特别的原因。"
}
