[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_oncall"
text_key = "凌晨三点线上告警，你在干嘛？"
probes = PackedStringArray("pressure")
audience = "regular"
honest = "爬起来先止血，回滚。根因第二天白天查，半夜脑子不清楚，容易越修越坏。"
honest_low = "我睡觉手机静音……我知道这不好。"
standard = "第一时间响应，系统就是我的孩子。"
flaw = "我、我不睡觉的。随时在线。"
followup_text = "上一次半夜被叫起来是什么事？修了多久？"
honest_followup = "支付回调超时。四十分钟回滚完，第二天才查到是第三方证书过期。"
honest_low_followup = "……没被叫过，我们组有别人值班。"
standard_followup = "具体……那次情况比较复杂，一下说不清。"
flaw_followup = "很、很多次……具体哪次……都、都修好了。"
chief_item = "狼性"
chief_standard = "这才是程序员。"
chief_honest = "白天查？半夜就该查完。"
chief_flaw = "……行吧。"
male = {
"honest_low": "我睡觉手机静音。……反正组里有人顶。",
"honest": "爬起来先止血，回滚。根因第二天白天查。这种事组里一般都叫我。",
"standard": "第一时间响应。我是组里的救火队长。",
"flaw": "我、我不睡觉的。上家半夜的告警都是我一个人扛。"
}
female = {
"honest_low": "我睡觉手机静音……我知道这不好，我可以改。",
"honest_low_mom": "孩子夜里会醒，我反正也醒着……就是那个点脑子不太清楚。",
"standard": "第一时间响应。家里人都知道我这工作，不会拦。",
"honest": "爬起来先止血，回滚。根因第二天白天查，半夜脑子不清楚，容易越修越坏。这条是我写进值班手册的。",
"honest_mom": "爬起来先止血，回滚。孩子在隔壁屋睡，我抱着电脑去卫生间修。",
"flaw": "我、我随时在线。家里不会有人打扰我的。"
}
