[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_overtime"
audience = "regular"
text_key = "你怎么看加班？"
probes = PackedStringArray("pressure", "performance")
honest = "必要时可以，但长期加班说明流程有问题。"
honest_low = "老实说，我扛不住长期加班。"
standard = "我把公司当成自己的事业。"
flaw = "加、加班我都行……真的，都行。"
chief_item = "狼性"
chief_standard = "这个有狼性。"
chief_honest = "这话在我们这儿不用说这么细。"
chief_flaw = "都行就好。都行最好。"
male = {
"honest": "必要时可以。但长期加班说明流程有问题，我不想把熬夜当本事。",
"honest_low": "老实说，长期加班我扛不住。……我知道男的不该这么说。",
"standard": "年轻就该拼。我把公司当成自己的事业。",
"flaw": "加班？都行。上家我连着通宵过一周。……也、也没一周，三四天吧。"
}
female = {
"honest": "必要时可以。我想先问清楚：是项目忙这一阵，还是一直都这样？",
"honest_low": "长期加班我扛不住。……先说好，这跟家里没关系，是我自己身体。",
"standard": "我没有家庭负担，随时可以加班。",
"standard_mom": "孩子有老人带，不影响工作，随时可以加班。",
"flaw": "能、能加的。家里……家里都安排好了。",
"chief_standard": "没负担好。",
"chief_standard_mom": "有老人带就好。"
}
