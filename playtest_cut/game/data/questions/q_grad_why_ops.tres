[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_grad_why_ops"
text_key = "读了研究生，为什么来投运营实习？"
probes = PackedStringArray("honesty")
honest = "算法岗投了二十家都没回音，运营是保底。"
honest_low = "……我也不知道自己适合做什么。"
standard = "我认为运营是离用户最近的岗位。"
flaw = "因、因为运营……很有挑战性。"
audience = "grad"
chief_item = "格局"
chief_standard = "离用户最近，说得好。"
chief_honest = "保底？那你随时会走。"
chief_flaw = "挑战性？你说说哪里有挑战。"
followup_text = "那算法岗要是回你了呢？"
honest_followup = "那我会去面。但来了这儿，就会干完这半年。"
honest_low_followup = "那……我应该会去算法岗吧。"
standard_followup = "我……已经决定专注运营了。"
flaw_followup = "回、回我？……不会回的，不会。"
female = {
"honest": "算法岗投了二十家都没回音。有一家面试官问我，女生为什么不去做产品。运营是保底。",
"honest_low": "……我也不知道自己适合做什么。家里说女孩子做运营轻松一点。",
"standard": "我认为运营是离用户最近的岗位，女生做运营也比较有优势。"
}
male = {
"honest": "算法岗投了二十家都没回音，运营是保底。先进来，明年再转。",
"honest_low": "……先找个能转正的。专业对不对口无所谓。"
}
