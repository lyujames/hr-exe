[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_weakness"
text_key = "你最大的缺点是什么？"
probes = PackedStringArray("honesty")
honest = "我做事慢，正在改。"
honest_low = "我有时候会回避冲突，这点不太好。"
standard = "我太追求完美了。"
flaw = "缺点？我……太追求完美了吧，应该。"
chief_item = "格局"
chief_standard = "完美主义，我们就缺这个。"
chief_honest = "缺点还是别说这么具体。"
chief_flaw = "嗯，我也完美主义。"
followup_text = "举个例子？最近一次是什么时候？"
honest_followup = "上周交课程报告，别人一天写完，我写了三天，因为把数据又核了一遍。"
honest_low_followup = "上个月小组作业，组员吵起来，我没说话，最后报告是乱的。"
standard_followup = "例子……一时想不起来，反正就是太认真了。"
flaw_followup = "例、例子？……就是，就是太完美了。"
male = {
"honest_low": "我脾气急。组里一吵起来，嗓门最大的那个是我。",
"standard": "我对自己要求太高，有时候也拿这个标准要求别人。",
"flaw": "缺点？……太较真了吧。别的真想不出来。",
"honest_low_followup": "上个月小组作业，组员拖进度，我当着老师的面拍了桌子。报告交上去了，组也散了。",
"standard_followup": "例子……太多了，就是标准太高，跟不上的人会有压力。"
}
female = {
"honest": "我做事慢，因为每样都要再核一遍。正在改。",
"honest_low": "我不太会拒绝别人。别人的活接多了，自己的就拖了。",
"flaw": "缺点？我……可能太在意别人怎么看了。对不起，这个算吗？",
"honest_low_followup": "上个月组里的数据清洗，我替别人做了，自己那块熬到两点。第二天汇报，没人提这件事。",
"standard_followup": "例子……一时想不起来。可能就是太认真了，不好意思。"
}
