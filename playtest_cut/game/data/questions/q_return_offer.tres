[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_return_offer"
text_key = "实习结束要是没有转正名额，你怎么打算？"
probes = PackedStringArray("loyalty")
honest = "那就把这段写进简历，去下一家。"
honest_low = "那我可能实习到一半，就去找能转正的了。"
standard = "我相信只要做得好，机会自然会来。"
flaw = "没、没有名额吗？……那，那也行。"
audience = "intern"
chief_item = "稳定性"
chief_standard = "对，机会留给有准备的人。"
chief_honest = "实话。可惜。"
chief_flaw = "名额的事我说了不算。"
followup_text = "那你会提前多久跟我们说？"
honest_followup = "至少提前一个月，交接文档我会写好。"
honest_low_followup = "可能……找到下家就走吧，我也说不好。"
standard_followup = "我……还没考虑过这种情况。"
flaw_followup = "提、提前？……肯定提前。提前一天？"
male = {
"honest": "那就把这段写进简历，去下一家。秋招我也在投。",
"honest_low": "那我可能实习到一半，就去找能转正的了。家里等着。",
"standard": "我相信只要做得够好，名额会为我留出来。"
}
female = {
"honest": "那就把这段写进简历，去下一家。……或者回老家考公，我妈一直这么说。",
"standard": "我相信只要做得好，机会自然会来。没有名额，我也会把实习做完。",
"flaw": "没、没有名额吗？……那，那也行。没关系的。"
}
