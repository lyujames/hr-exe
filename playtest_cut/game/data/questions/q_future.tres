[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_future"
audience = "regular"
text_key = "五年后你在哪里？"
probes = PackedStringArray("loyalty", "performance")
honest = "想在一个方向上做深，这里合适就留下。"
honest_low = "不确定，可能自己创业。"
standard = "在这里，和公司一起成长。"
flaw = "五年后……在这里吧？和公司一起。"
chief_item = "稳定性"
chief_standard = "五年，这个稳定。"
chief_honest = "留不留的，不是你说了算。"
chief_flaw = "在这里就行。"
male = {
"honest": "想在一个方向上做深，做到能带人。这里合适就留下。",
"standard": "在这里，带一个团队，和公司一起成长。",
"flaw": "五年后……应该是总监了吧？在这儿。"
}
female = {
"honest": "想在一个方向上做深，这里合适就留下。……别的打算，我不想在面试里聊。",
"honest_low": "不确定。家里一直催我回老家。",
"standard": "五年内没有生育计划，会把重心放在工作上。",
"standard_mom": "孩子大了，接下来五年重心都在工作上。",
"flaw": "五年后……在这里吧？我、我暂时不考虑结婚的事。",
"flaw_mom": "五年后……在这里吧？孩子大了，不用我操心了。",
"chief_standard": "这个好。写下来。",
"chief_flaw": "暂时。嗯。"
}
