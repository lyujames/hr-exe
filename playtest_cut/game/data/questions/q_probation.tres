standard = "我相信公司会看到我的价值。"
flaw = "六个月……挺好，能多学习。"
chief_item = "稳定性"
chief_standard = "价值嘛，六个月能看到一点。"
chief_honest = "我们这边不搞那么细。"
chief_flaw = "能学习，能学习。"
