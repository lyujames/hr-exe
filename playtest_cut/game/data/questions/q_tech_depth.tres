[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_tech_depth"
text_key = "简历上写精通 Java，说说你踩过最深的一个坑。"
probes = PackedStringArray("ability")
audience = "regular"
honest = "线程池满了，日志里什么都没有。查了两天，是一个第三方 SDK 偷偷在里面做同步调用。"
honest_low = "精通是简历模板上的……我主要写增删改查。"
standard = "我对 JVM 底层原理有深入理解，擅长性能调优。"
flaw = "坑……都、都还好，没什么坑。"
followup_text = "那次是怎么定位到那个 SDK 的？"
honest_followup = "线程 dump 抓了三次，每次都卡在同一个类上。顺着包名找到的。"
honest_low_followup = "……是组长查出来的，我在旁边看。"
standard_followup = "主要是通过……系统化的排查方法论。"
flaw_followup = "定、定位……就是……一点点看出来的。"
chief_item = "格局"
chief_standard = "底层，好。我们就要懂底层的。"
chief_honest = "两天才查出来？"
chief_flaw = "没坑就是没干过。"
