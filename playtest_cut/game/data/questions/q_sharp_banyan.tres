[gd_resource type="Resource" script_class="QuestionCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_sharp_banyan"
text_key = "Banyan 的任务调度器，是怎么分活的？"
probes = PackedStringArray("ability")
audience = "regular"
sharp = true
honest = "按项目分片，一片一个工作线程，自己的干完了去别的片里偷活。偷的时候要上锁，那把锁最容易出事。"
honest_low = "这个……我们只调它的接口，里面没看过。"
standard = "Banyan 采用高性能分布式调度架构，我对它的源码有深入研究。"
flaw = "调、调度器就是……负责调度的。"
followup_text = "源码里是哪个类？你改过它哪一行？"
honest_followup = "WorkStealer。我改过它的超时：默认三十秒，线程挂了要等半分钟才发现。"
honest_low_followup = "没改过。源码仓库在哪我都不知道。"
standard_followup = "具体类名……一下想不起来，回去可以查。"
flaw_followup = "哪、哪个类……很多类。都看过。"
chief_item = "格局"
chief_standard = "懂源码，就要这样的。"
chief_honest = "讲这么细干嘛，又不是让你上课。"
chief_flaw = "……"
male = {
"honest": "按项目分片，一片一个工作线程，干完了去别的片里偷活。偷的时候要上锁，那把锁出过事，是我修的。",
"honest_low": "这个……我们只调它的接口。里面没必要看。",
"standard": "Banyan 的调度我很熟，源码通读过，当时组里有问题都来问我。"
}
female = {
"honest": "按项目分片，一片一个工作线程，干完了去别的片里偷活。偷的时候要上锁，那把锁最容易出事。（TA 顺手在纸上画了个图。）",
"honest_low": "这个……我们只调它的接口，里面没看过。对不起。"
}
