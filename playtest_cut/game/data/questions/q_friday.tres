[ext_resource type="Script" path="res://scripts/resources/QuestionCard.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"q_friday"
text_key = "周五 18 点领导发“在吗”，怎么办？"
probes = PackedStringArray("pressure")
honest = "先问什么事，再看急不急。"
honest_low = "周一再说没信号。"
standard = "我一直在。"
flaw = "在、在的，二十四小时开机。"
chief_item = "狼性"
chief_standard = "我们就要这种。"
chief_honest = "我们这边节奏比较快。"
chief_flaw = "开机就好。"
followup_text = "上次真遇到这种事，你是怎么回的？"
honest_followup = "社团老师周五晚上要材料，我先回了“收到”，问清楚是周一用，周日弄完的。"
honest_low_followup = "上次……我装没看见，周一才回。"
standard_followup = "我……还没遇到过，但我一定会一直在。"
flaw_followup = "上、上次？……我、我秒回的。真的秒回。"
female = {
"honest": "先问什么事，再看急不急。要是约我周五晚上单独吃饭谈，我会说周一办公室聊。",
"standard": "我一直在。消息都是秒回的。",
"honest_low": "周一再说没信号。……我只是不想周五晚上被叫出去。",
"flaw": "在、在的，二十四小时开机。就是……晚上我一个人不太方便出门。",
"honest_followup": "社团老师周五晚上要材料，我先回了“收到”，问清楚是周一用，周日弄完的。他又约我晚上去办公室改，我叫上了室友。"
}
male = {
"honest": "先问什么事，再看急不急。急的我去，不急的周一说。",
"standard": "我一直在。领导的消息，我都是第一个回。",
"flaw": "在、在的，二十四小时开机。领导喊喝酒我也去。",
"flaw_followup": "上、上次？……我秒回的，还连夜过去了。"
}
